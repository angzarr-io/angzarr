# angzarr-presentation: JSON or UTF-8 text at a driving edge, diagnostics
# rendered from Fluent catalogs, display-width text helpers. Depends on
# angzarr-diagnostic, Fluent and serde only. A member of angzarr-core's
# workspace: every recipe names this package, and --locked means the
# workspace's Cargo.lock. Runs on the host, not in core's toolchain
# container (`just -f crates/angzarr-presentation/justfile check`).

# Format check, build, lint and test natively, the test support too
check: fmt-check build lint test

fmt:
    cargo fmt -p angzarr-presentation

fmt-check:
    cargo fmt -p angzarr-presentation --check

# The crate, and its test support (`test-support`) as other crates' tests
# build it
build:
    cargo build --locked -p angzarr-presentation
    cargo build --locked -p angzarr-presentation --features test-support

lint:
    cargo clippy --locked -p angzarr-presentation --all-targets --features test-support -- -D warnings

test:
    cargo test --locked -p angzarr-presentation

# Mutation kill-rate threshold, percent, over viable mutants; 90 is the
# org's bar. No git hook runs mutation; the full pass runs weekly in CI
# (.github/workflows/mutation-shared-crates.yml). The work is the root
# justfile's shared-mutation (a scratch copy, never --in-place).
MUTATION_THRESHOLD := "90"
# Seconds per mutant's tests: the suite takes about a second.
MUTATION_TIMEOUT := "20"

# Mutation-test the whole crate, judged by MUTATION_THRESHOLD: the full pass.
mutation-test:
    just -f '{{justfile_directory()}}/../../justfile' shared-mutation angzarr-presentation {{MUTATION_THRESHOLD}} {{MUTATION_TIMEOUT}} target/mutants

# Mutation-test only the lines the diff PATCH changes, judged the same way.
mutation-diff PATCH:
    just -f '{{justfile_directory()}}/../../justfile' shared-mutation angzarr-presentation {{MUTATION_THRESHOLD}} {{MUTATION_TIMEOUT}} target/mutants-diff '{{PATCH}}'
