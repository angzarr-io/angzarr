# angzarr-bus: the bus interface (subscriptions of projectors and policies
# served from a stream store) and its conformance suite, transport-free: no
# router, no runtime. A member of angzarr-core's workspace: every recipe
# names this package, and --locked means the workspace's Cargo.lock. Runs on
# the host, not in core's toolchain container
# (`just -f crates/angzarr-bus/justfile check`).

# Format check, build, lint and test natively, then the wasm32 builds
check: check-untested tests

# Every check but running the tests, the tests' build included: a failure
# here is never a red test (the root justfile's `check-shared-crates-commit`)
check-untested: fmt-check build lint wasm build-tests

# Run the tests: a failure here is a red test
tests: test

fmt:
    cargo fmt -p angzarr-bus

fmt-check:
    cargo fmt -p angzarr-bus --check

build:
    cargo build --locked -p angzarr-bus --all-features

# Lint, test and build-tests run both flavours: `--all-features` is the `purge`
# flavour (the purge capability on); the explicit feature list is the default
# one (append-only, no purge API).
lint:
    cargo clippy --locked -p angzarr-bus --all-targets --all-features -- -D warnings
    cargo clippy --locked -p angzarr-bus --all-targets --features contract -- -D warnings

test:
    cargo test --locked -p angzarr-bus --all-features
    cargo test --locked -p angzarr-bus --features contract

# Build the tests without running them
build-tests:
    cargo test --locked -p angzarr-bus --all-features --no-run
    cargo test --locked -p angzarr-bus --features contract --no-run

# The interface and its suite must build for the browser, where a bus's
# futures need not be Send
wasm:
    cargo build --locked -p angzarr-bus --target wasm32-unknown-unknown
    cargo build --locked -p angzarr-bus --target wasm32-unknown-unknown --all-features

# Mutation kill-rate threshold, percent, over viable mutants; 90 is the
# org's bar. No git hook runs mutation; the full pass runs weekly in CI
# (.github/workflows/mutation-shared-crates.yml). The work is the root
# justfile's shared-mutation (a scratch copy, never --in-place). The suite
# (src/contract.rs) is exercised by the implementations that run it.
MUTATION_THRESHOLD := "90"
MUTATION_TIMEOUT := "120"

# Mutation-test the whole crate, judged by MUTATION_THRESHOLD: the full pass.
mutation-test:
    just -f '{{justfile_directory()}}/../../justfile' shared-mutation angzarr-bus {{MUTATION_THRESHOLD}} {{MUTATION_TIMEOUT}} target/mutants

# Mutation-test only the lines the diff PATCH changes, judged the same way.
mutation-diff PATCH:
    just -f '{{justfile_directory()}}/../../justfile' shared-mutation angzarr-bus {{MUTATION_THRESHOLD}} {{MUTATION_TIMEOUT}} target/mutants-diff '{{PATCH}}'
