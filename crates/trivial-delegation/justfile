# trivial-delegation: the `#[trivial_delegation]` attribute macro. A member of
# angzarr-core's workspace: every recipe names this package, and --locked
# means the workspace's Cargo.lock. Runs on the host, not in core's toolchain
# container (`just -f crates/trivial-delegation/justfile check`). A proc
# macro runs on the host only, so there is no wasm32 build.

# Format check, build, lint and test natively
check: fmt-check build lint test

fmt:
    cargo fmt -p trivial-delegation

fmt-check:
    cargo fmt -p trivial-delegation --check

build:
    cargo build --locked -p trivial-delegation

lint:
    cargo clippy --locked -p trivial-delegation --all-targets -- -D warnings

test:
    cargo test --locked -p trivial-delegation
