# angzarr-reads: the coordinators' read engine (GetEvents, GetEventBook,
# correlated reads, ListStreams), transport-free and linking NO command code:
# base, ports, proto and diagnostic only, no tonic, no tokio. A read-only
# container links this crate alone. A member of angzarr-core's workspace:
# every recipe names this package, and --locked means the workspace's
# Cargo.lock. Runs on the host, not in core's toolchain container
# (`just -f crates/angzarr-reads/justfile check`).

# Format check, build, lint and test natively, then the wasm32 build
check: check-untested tests

# Every check but running the tests, the tests' build included: a failure
# here is never a red test (the root justfile's `check-shared-crates-commit`)
check-untested: fmt-check build lint wasm build-tests

# Run the tests: a failure here is a red test
tests: test

fmt:
    cargo fmt -p angzarr-reads

fmt-check:
    cargo fmt -p angzarr-reads --check

build:
    cargo build --locked -p angzarr-reads

lint:
    cargo clippy --locked -p angzarr-reads --all-targets -- -D warnings

test:
    cargo test --locked -p angzarr-reads

# Build the tests without running them
build-tests:
    cargo test --locked -p angzarr-reads --no-run

# The crate must stay transport-free and build for the browser
wasm:
    cargo build --locked -p angzarr-reads --target wasm32-unknown-unknown

# Mutation kill-rate threshold, percent, over viable mutants; 90 is the
# org's bar. No git hook runs mutation; the full pass runs weekly in CI
# (.github/workflows/mutation-shared-crates.yml). The work is the root
# justfile's shared-mutation (a scratch copy, never --in-place).
MUTATION_THRESHOLD := "90"
# Seconds per mutant's tests: the suite builds the crate for wasm32 once.
MUTATION_TIMEOUT := "120"

# Mutation-test the whole crate, judged by MUTATION_THRESHOLD: the full pass.
mutation-test:
    just -f '{{justfile_directory()}}/../../justfile' shared-mutation angzarr-reads {{MUTATION_THRESHOLD}} {{MUTATION_TIMEOUT}} target/mutants

# Mutation-test only the lines the diff PATCH changes, judged the same way.
mutation-diff PATCH:
    just -f '{{justfile_directory()}}/../../justfile' shared-mutation angzarr-reads {{MUTATION_THRESHOLD}} {{MUTATION_TIMEOUT}} target/mutants-diff '{{PATCH}}'
