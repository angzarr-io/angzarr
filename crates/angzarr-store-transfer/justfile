# angzarr-store-transfer: a store carried across a proto generation as
# JSONL (the store export/import plan). Depends on angzarr-ports,
# angzarr-diagnostic, prost-reflect and serde_json. A member of
# angzarr-core's workspace: every recipe names this package, and --locked
# means the workspace's Cargo.lock. Runs on the host, not in core's
# toolchain container (`just -f crates/angzarr-store-transfer/justfile check`).
# Needs protoc on PATH (angzarr-proto's build).

# Format check, build, lint and test natively
check: check-untested tests

# Every check but running the tests, the tests' build included: a failure
# here is never a red test (the root justfile's `check-shared-crates-commit`)
check-untested: fmt-check build lint build-tests

# Run the tests: a failure here is a red test
tests: test

fmt:
    cargo fmt -p angzarr-store-transfer

fmt-check:
    cargo fmt -p angzarr-store-transfer --check

build:
    cargo build --locked -p angzarr-store-transfer

lint:
    cargo clippy --locked -p angzarr-store-transfer --all-targets -- -D warnings

test:
    cargo test --locked -p angzarr-store-transfer

# Build the tests without running them
build-tests:
    cargo test --locked -p angzarr-store-transfer --no-run

# Mutation kill-rate threshold, percent, over viable mutants; 90 is the
# org's bar. No git hook runs mutation; the work is the root justfile's
# shared-mutation (a scratch copy, never --in-place).
MUTATION_THRESHOLD := "90"
# Seconds per mutant's tests.
MUTATION_TIMEOUT := "60"

# Mutation-test the whole crate, judged by MUTATION_THRESHOLD: the full pass.
mutation-test:
    just -f '{{justfile_directory()}}/../../justfile' shared-mutation angzarr-store-transfer {{MUTATION_THRESHOLD}} {{MUTATION_TIMEOUT}} target/mutants

# Mutation-test only the lines the diff PATCH changes, judged the same way.
mutation-diff PATCH:
    just -f '{{justfile_directory()}}/../../justfile' shared-mutation angzarr-store-transfer {{MUTATION_THRESHOLD}} {{MUTATION_TIMEOUT}} target/mutants-diff '{{PATCH}}'
